// int-from-text: in a read body, v := <parse>(…) (a let or an assign into a local) with no <, <=,
// > or >= on v anywhere in the function, and either a conversion of v to an integer type
// narrower than what the parse can give (its result type, or its bit size argument when that is
// a constant), or a word of v's name in ranged.

names parse = ["strconv.Atoi", "strconv.ParseInt", "strconv.ParseUint"].
names ranged = ["port", "status"].

parse_into(F, V, X, S) :- stmt{id: S, kind: "let", func: F}, let_name{stmt: S, index: 0, name: V},
                          V != "_", expr{parent: S, slot: "rhs", index: 0, id: X},
                          call{site: X, callee: C}, C in @names.parse.
parse_into(F, V, X, S) :- stmt{id: S, kind: "assign", op: "", func: F},
                          expr{parent: S, slot: "lhs", index: 0, kind: "var", name: V}, V != "_",
                          expr{parent: S, slot: "rhs", index: 0, id: X},
                          call{site: X, callee: C}, C in @names.parse.

// The bits the parse's integer result can hold.
gives(X, B) :- parse_into(_, _, X, _), expr{id: X, t: T}, type_elem{type: T, index: 0, t: R},
               type{id: R, bits: B}, B > 0.
gives(X, B) :- parse_into(_, _, X, _), expr{id: X, t: T}, type{id: T, bits: B}, B > 0.
size(X, N) :- parse_into(_, _, X, _),
              expr{parent: X, slot: "args", index: 2, kind: "lit", value: V}, int(V, N), N > 0.
smaller(X, N) :- gives(X, B), size(X, N), N < B.
can_give(X, B) :- smaller(X, B).
can_give(X, B) :- gives(X, B), !smaller(X, _).

compared(F, V) :- expr{func: F, kind: "binop", op: ~"^(<|<=|>|>=)$", id: E}, contains(E, U),
                  expr{id: U, kind: "var", name: V}.

narrowed(Pos, F, V) :- parse_into(F, V, X, _), can_give(X, B),
                       expr{func: F, kind: "conv", x: Y, t: To, stmt: S},
                       expr{id: Y, kind: "var", name: V}, To.bits > 0, To.bits < B,
                       stmt{id: S, pos: Pos}.

finding(Pos, F) :- narrowed(Pos, F, V), !compared(F, V).
finding(Pos, F) :- parse_into(F, V, _, S), word(V, _, W), W in @names.ranged, !compared(F, V),
                   !narrowed(_, F, V), stmt{id: S, pos: Pos}.

?- finding(Pos, F).
