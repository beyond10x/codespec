// case-fold-asymmetry: two sibling methods of one type, where one calls a fold and the other
// calls none and compares two strings, neither a constant, with == or != in its read body. A
// fold is a call fold names, or of a function of the set one of whose words is in fold_words,
// or of a plain function from one string to a string that calls a fold, to a fixed point.
// Siblings share a word of their names other than the first; methods of one word all do.

names fold = [
  "strings.ToLower", "strings.ToUpper", "strings.EqualFold", "bytes.ToLower", "bytes.ToUpper",
  "bytes.EqualFold", "unicode.ToLower", "unicode.ToUpper",
  "net/textproto.CanonicalMIMEHeaderKey", "net/http.CanonicalHeaderKey"
].
names fold_words = ["lower", "upper", "fold", "canonical"].

plain(G) :- func{id: G, kind: "func"}, param{func: G, index: 0, t: "string"},
            !param{func: G, index: 1}, result{func: G, index: 0, t: "string"},
            !result{func: G, index: 1}.

fold_fun(G) :- func{id: G, name: N}, word(N, _, W), W in @names.fold_words.
fold_fun(G) :- plain(G), calls_fold(G).
calls_fold(F) :- call{func: F, callee: C}, C in @names.fold.
calls_fold(F) :- call{func: F, site: S}, calls{site: S, target: G}, fold_fun(G).

stem(F, W) :- func{id: F, name: N}, word(N, I, W), I > 0.
stem(F, "<type>") :- func{id: F}, K = count{ func{id: F, name: N}, word(N, I, _) }, K < 2.
siblings(A, B) :- func{id: A, module: M, recv: R}, R != "", func{id: B, module: M, recv: R},
                  A != B, stem(A, W), stem(B, W).

stringy(T) :- type{id: T, kind: "string"}.
stringy(T) :- type{id: T, kind: "named", decl: ~"^(newtype|enum)$", under: U},
              type{id: U, kind: "string"}.
constant(E) :- expr{id: E, kind: ~"^(lit|const)$"}.

compares(B, Pos, L) :- expr{func: B, kind: "binop", op: ~"^(==|!=)$", x: X, y: Y, stmt: S},
                       expr{id: X, t: TX}, stringy(TX), expr{id: Y, t: TY}, stringy(TY),
                       !constant(X), !constant(Y), stmt{id: S, pos: Pos, line: L}.
first_compare(B, Pos) :- compares(B, Pos, L), L = min{ L2 : compares(B, _, L2) }.

asymmetry(Pos, B) :- siblings(A, B), calls_fold(A), !calls_fold(B), first_compare(B, Pos).

?- asymmetry(Pos, B).
