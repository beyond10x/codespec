// clone-aliasing: sibling clone functions (a word in clone; one name once a type name of the
// module in it is replaced, or one method name on two types), where one calls a copy function and
// another calls none and passes a slice through: a struct literal field or a field assignment
// whose value is a slice read from a field or a method (read body).

names clone = ["clone", "copy", "dup", "duplicate"].
names copy = ["slices.Clone", "bytes.Clone", "maps.Clone", "Clone", "clone"].

clone_word(W) :- E in @names.clone, word(E, _, W).
clone_fn(F, M, N) :- func{id: F, module: M, name: N, kind: K}, K != "lambda",
                     word(N, _, W), clone_word(W).
module_type(M, T) :- type{kind: "named", path: M, name: T, decl: D}, D != "".
module_type(M, T) :- func{module: M, kind: "opaque", recv: T}, T != "".

typed_shape(F, M, K) :- clone_fn(F, M, N), module_type(M, T), replace(N, T, "<T>", K), K != N.
shape(F, M, K) :- typed_shape(F, M, K).
shape(F, M, N) :- clone_fn(F, M, N), !typed_shape(F, M, _).
siblings(A, B) :- shape(A, M, K), shape(B, M, K), A != B.

// The names a call goes by, as codespec check matches a list entry against it.
call_name(S, Nm) :- call{site: S, name: Nm}, Nm != "".
call_name(S, C) :- call{site: S, callee: C, name: Nm}, Nm != "".
call_name(S, PN) :- call{site: S, path: P, name: Nm}, Nm != "", concat(P, ".", Q), concat(Q, Nm, PN).
call_name(S, RN) :- call{site: S, path: P, type: T, name: Nm}, Nm != "", T != "",
                    concat(P, ".", Q), replace(T, Q, "", R), concat(R, ".", R2), concat(R2, Nm, RN).
copies(F) :- call{func: F, site: S}, call_name(S, N), N in @names.copy.

passed_slice(V) :- expr{id: V, kind: ~"^(field|method|extern_method|iface_call)$", t: T},
                   type{id: T, kind: "slice"}.
passes(B, L, Pos) :- field_init{expr: E, value: V}, passed_slice(V), expr{id: E, func: B, stmt: S},
                     stmt{id: S, line: L, pos: Pos}.
passes(B, L, Pos) :- stmt{id: S, kind: "assign", func: B, line: L, pos: Pos},
                     expr{parent: S, slot: "lhs", index: I, kind: "field"},
                     expr{parent: S, slot: "rhs", index: I, id: V}, passed_slice(V).
first_pass(B, Pos) :- passes(B, L, Pos), L = min{ L2 : passes(B, L2, _) }.

aliasing(Pos, B) :- siblings(A, B), copies(A), !copies(B), first_pass(B, Pos).

?- aliasing(Pos, B).
