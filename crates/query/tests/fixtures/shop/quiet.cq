// The functions main reaches that call no log, and how many calls each makes.
reached_from_main(G) :- func{id: F, name: "main"}, reaches(F, G).
calls_log(F) :- call{func: F, callee: "example.com/shop.log"}.
quiet(F) :- reached_from_main(F), !calls_log(F).
?- quiet(F), N = count{ call{func: F, site: S} }.
