      "id": "stmt.assign",
      "family": "statement",
      "description": "`lhs = rhs`, or `lhs <op> rhs` for a compound operator: `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `&^=`, `<<=` or `>>=`."
    },
    {
      "id": "stmt.break",
      "family": "statement",
      "description": "Leaves the innermost enclosing `for` or `for_range`."
    },
    {
      "id": "stmt.continue",
      "family": "statement",
      "description": "Ends the current iteration of the innermost enclosing `for` or `for_range`."
    },
