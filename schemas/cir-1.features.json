{
  "format": "codespec-features/1",
  "cir": "cir/1",
  "features": [
    {
      "id": "assign.add",
      "family": "operator",
      "op": "+=",
      "description": "`+=`: addition, or string concatenation, assigned to the left-hand side"
    },
    {
      "id": "assign.and",
      "family": "operator",
      "op": "&=",
      "description": "`&=`: bitwise and, assigned to the left-hand side"
    },
    {
      "id": "assign.and_not",
      "family": "operator",
      "op": "&^=",
      "description": "`&^=`: bit clear: x and not y, assigned to the left-hand side"
    },
    {
      "id": "assign.div",
      "family": "operator",
      "op": "/=",
      "description": "`/=`: division, assigned to the left-hand side"
    },
    {
      "id": "assign.mul",
      "family": "operator",
      "op": "*=",
      "description": "`*=`: multiplication, assigned to the left-hand side"
    },
    {
      "id": "assign.or",
      "family": "operator",
      "op": "|=",
      "description": "`|=`: bitwise or, assigned to the left-hand side"
    },
    {
      "id": "assign.rem",
      "family": "operator",
      "op": "%=",
      "description": "`%=`: remainder, assigned to the left-hand side"
    },
    {
      "id": "assign.shl",
      "family": "operator",
      "op": "<<=",
      "description": "`<<=`: left shift, assigned to the left-hand side"
    },
    {
      "id": "assign.shr",
      "family": "operator",
